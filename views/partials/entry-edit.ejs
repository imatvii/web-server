<li id="entry-<%= entry.id %>">
  <form
    class="edit-form"
    hx-put="/entries/<%= entry.id %>"
    hx-target="closest li"
    hx-swap="outerHTML"
    hx-disabled-elt="find button[type='submit']"
  >
    <input type="text" name="title" value="<%= entry.title %>">
    <input type="text" name="body" value="<%= entry.body %>">
    <button type="submit">Save</button>
    <button
      class="cancel-btn"
      type="button"
      hx-get="/entries/<%= entry.id %>"
      hx-target="closest li"
      hx-swap="outerHTML"
    >Cancel</button>
  </form>
</li>